<paper-page tabbar="{{true}}">
  <nav-bar title="米诺战略参谋部">
    <streak-chip wx:if="{{streakDays > 0}}" slot="action" days="{{streakDays}}"></streak-chip>
  </nav-bar>

  <scroll-view
    class="chat__scroll"
    scroll-y
    scroll-into-view="{{scrollToId}}"
    scroll-with-animation
    enable-flex
  >
    <!-- 问候区：印章「势」+ 标题 + 报告数副文 -->
    <view class="greet">
      <seal-avatar variant="marshal" size="100" text="势"></seal-avatar>
      <view class="greet__text">
        <view class="greet__title">兄弟，坐下聊。</view>
        <view class="greet__sub"
          >已为你写下 <text class="greet__hl">{{reportTotal}} 份报告</text> · 越聊我越懂你</view
        >
      </view>
    </view>

    <!-- 今日一问·深墨卡（M5 接 GET /tasks/today；show/文案由 status 控制）-->
    <daily-question-card
      show="{{daily.show}}"
      question="{{daily.question}}"
      hint="{{daily.hint}}"
      estMinutes="{{daily.estMinutes}}"
      unread="{{daily.unread}}"
      started="{{daily.started}}"
      bind:start="onDailyStart"
    ></daily-question-card>

    <!-- 消息流 -->
    <view class="chat__list">
      <block wx:for="{{messages}}" wx:key="id">
        <!-- reportOffer 占位：军师系统提示样式（浅色小字）-->
        <view wx:if="{{item.role === 'system'}}" class="sysnote">{{item.content}}</view>
        <message-bubble wx:else role="{{item.role}}" content="{{item.content}}"></message-bubble>
      </block>

      <!-- 正在生成的军师气泡：typing=首 token 前三点；streaming=逐 token 追加（独立 data 路径）-->
      <message-bubble wx:if="{{typing}}" role="assistant" loading="{{true}}"></message-bubble>
      <message-bubble
        wx:elif="{{streaming.active}}"
        role="assistant"
        content="{{streaming.text}}"
      ></message-bubble>

      <!-- 回复完成后的「接着聊」建议气泡 -->
      <suggestion-chips items="{{suggestions}}" bind:select="onSuggestionSelect"></suggestion-chips>

      <!-- 错误重发 -->
      <view wx:if="{{canRetry}}" class="retry" hover-class="retry--hover" bindtap="onRetry"
        >· 点此重发 ·</view
      >
    </view>

    <view id="bottomAnchor" class="chat__anchor"></view>
  </scroll-view>

  <!-- 底部输入条 -->
  <view class="inputbar">
    <textarea
      class="inputbar__field"
      value="{{input}}"
      placeholder="说说你的想法……"
      auto-height
      maxlength="-1"
      cursor-spacing="20"
      adjust-position
      show-confirm-bar="{{false}}"
      disabled="{{sending}}"
      bindinput="onInput"
    ></textarea>
    <view
      class="inputbar__send {{(input && !sending) ? '' : 'inputbar__send--off'}}"
      hover-class="inputbar__send--hover"
      bindtap="onSend"
      >↑</view
    >
  </view>

  <!-- 报告生成弹层 -->
  <generating-modal
    visible="{{modalVisible}}"
    phase="{{modalPhase}}"
    topic="{{modalTopic}}"
    type="{{modalType}}"
    bind:close="onModalClose"
    bind:view="onModalView"
  ></generating-modal>
</paper-page>
