/* 军师对话页布局：nav-bar / 可滚动内容区 / 输入条（纵向 flex）*/

/* 可滚动内容区：占满剩余高度并内部滚动 */
.chat__scroll {
  flex: 1;
  min-height: 0;
  padding: 12rpx 35rpx 0; /* 6px 18px */
  box-sizing: border-box;
}

/* 问候区：印章 + 标题 + 报告数副文 */
.greet {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0 20rpx;
}
.greet__title {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 38rpx; /* 19px */
  color: var(--color-ink);
}
.greet__sub {
  font-size: 23rpx; /* 11.5px */
  color: var(--color-ink-tertiary);
  margin-top: 8rpx;
}
.greet__hl {
  color: var(--color-gold);
}

/* 消息流 */
.chat__list {
  padding-top: 24rpx;
  display: flex;
  flex-direction: column;
}

/* reportOffer 系统提示行（浅色小字，居中）*/
.sysnote {
  text-align: center;
  font-size: 21rpx; /* 10.5px */
  color: var(--color-ink-faint);
  background: var(--color-ink-05);
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  margin: 4rpx auto 26rpx;
  align-self: center;
  max-width: 560rpx;
}

/* 错误重发提示 */
.retry {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-vermilion);
  padding: 8rpx 0 16rpx;
}
.retry--hover {
  opacity: 0.7;
}

/* 底部锚点（scrollIntoView 目标）*/
.chat__anchor {
  height: 2rpx;
}

/* 底部输入条 */
.inputbar {
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  padding: 20rpx 28rpx 16rpx; /* 10px 14px 8px */
  background: var(--color-surface-tab);
  border-top: 1px solid var(--border-hairline);
}
.inputbar__field {
  flex: 1;
  min-height: 40rpx;
  max-height: 156rpx; /* 约 3 行（auto-height 增高上限）*/
  padding: 18rpx 28rpx; /* 10px 14px */
  background: var(--color-card);
  border: 1px solid var(--border-soft);
  border-radius: 36rpx; /* 18px */
  font-size: 27rpx; /* 13.5px */
  line-height: 1.5;
  color: var(--color-ink);
}
.inputbar__send {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx; /* 38px */
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-round);
  background: var(--color-vermilion);
  color: var(--color-paper-start);
  font-size: 34rpx;
  box-shadow: 0 8rpx 24rpx rgba(178, 58, 46, 0.3);
}
/* 无输入 / 发送中：发送钮弱化并禁用观感 */
.inputbar__send--off {
  opacity: 0.4;
}
.inputbar__send--hover {
  opacity: 0.85;
}
