.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: var(--space-lg);
}
.brand {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 40rpx;
  letter-spacing: 8rpx;
  color: var(--color-ink);
}
.subtitle {
  margin-top: var(--space-md);
  font-family: var(--font-serif);
  font-size: 30rpx;
  color: var(--color-vermilion);
}
