<paper-page>
  <nav-bar title="{{navTitle}}" back="{{true}}" bind:back="onBack">
    <!-- 转发：open-type="share" 触发 onShareAppMessage（转发给朋友）-->
    <button
      wx:if="{{report}}"
      slot="action"
      class="detail__share-btn"
      open-type="share"
      hover-class="none"
    >分享</button>
  </nav-bar>

  <view wx:if="{{loading}}" class="detail__loading">米诺翻档中……</view>

  <!-- 首屏网络错误 -->
  <error-retry wx:elif="{{loadError}}" bind:retry="onRetry"></error-retry>

  <block wx:elif="{{report}}">
    <scroll-view class="detail__scroll" scroll-y enable-flex>
      <!-- 结构化头部（左对齐）-->
      <view wx:if="{{!narrative}}" class="head head--left">
        <type-chip type="{{report.type}}"></type-chip>
        <view class="head__title head__title--left">{{report.title}}</view>
        <view class="head__meta">{{originLabel}} · {{dateLabel}}</view>
      </view>

      <!-- 自传体头部（居中 + 装饰线）-->
      <view wx:else class="head head--center">
        <type-chip type="{{report.type}}" suffix="{{chipSuffix}}"></type-chip>
        <view class="head__title head__title--center">{{report.title}}</view>
        <view class="head__rule"></view>
      </view>

      <!-- 正文 -->
      <md-report body-md="{{report.bodyMd}}" type="{{report.type}}"></md-report>

      <!-- 米诺批注 -->
      <annotation-block
        wx:if="{{report.annotation}}"
        label="{{narrative ? '米诺批注' : '米诺一句话'}}"
        text="{{report.annotation}}"
      ></annotation-block>

      <!-- 溯源标签 -->
      <source-tags sources="{{report.sources}}" kb-synced="{{report.meta.kbSynced}}"></source-tags>

      <view class="detail__tail"></view>
    </scroll-view>

    <!-- 底部操作条 -->
    <detail-action-bar
      primary-text="{{primaryText}}"
      icons="{{secondaryIcons}}"
      bind:primary="onPrimary"
      bind:secondary="onSecondary"
    ></detail-action-bar>
  </block>

  <!-- 隐藏离屏 canvas：分享图绘制用（不占布局）-->
  <canvas type="2d" id="shareCanvas" class="detail__canvas"></canvas>
</paper-page>
