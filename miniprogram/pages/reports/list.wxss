.list__navsub {
  font-size: 21rpx; /* ~11px */
  color: var(--color-ink-tertiary);
}

.list {
  padding: 0 var(--space-lg) 32rpx;
}
.list__more,
.list__end {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-ink-faint);
  padding: 28rpx 0;
}

/* 空态 */
.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--space-xl) 0;
  gap: var(--space-lg);
}
.empty__title {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  color: var(--color-ink);
}
.empty__sub {
  font-size: 24rpx;
  color: var(--color-ink-tertiary);
  text-align: center;
  line-height: var(--lh-ui);
}
