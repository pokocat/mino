.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-xl);
  gap: var(--space-lg);
}
.empty__title {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  color: var(--color-ink);
}
.empty__sub {
  font-size: 24rpx;
  color: var(--color-ink-tertiary);
  text-align: center;
  line-height: var(--lh-ui);
}
