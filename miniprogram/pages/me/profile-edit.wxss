/* 画像编辑：复用 onboarding 入局态字段样式（field / submit）。 */
.edit {
  padding: var(--space-lg) var(--space-xl) 60rpx;
}
.edit__hint {
  display: block;
  margin-bottom: var(--space-lg);
  font-size: 24rpx;
  color: var(--color-ink-tertiary);
}

.field {
  margin-bottom: var(--space-lg);
}
.field__label {
  display: block;
  margin-bottom: var(--space-sm);
  font-size: 24rpx;
  color: var(--color-ink-secondary);
}
.field__input {
  width: 100%;
  box-sizing: border-box;
  padding: var(--space-md);
  background: var(--color-card);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius-card);
  font-size: 28rpx;
  color: var(--color-ink);
}
.field__textarea {
  min-height: 120rpx;
}
.field__ph {
  color: var(--color-ink-faint);
}

/* 保存按钮：朱砂 */
.submit {
  margin-top: var(--space-md);
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-card);
  background: var(--color-vermilion);
  box-shadow: var(--shadow-seal);
}
.submit--loading {
  opacity: 0.7;
}
.submit__text {
  font-size: 30rpx;
  color: var(--color-paper-start);
  letter-spacing: 4rpx;
}
