/* 今日一问·深墨块（任务派发）。本期静态占位。 */
.dq {
  position: relative;
  overflow: hidden;
  background: var(--color-ink);
  border-radius: var(--radius-card);
  padding: 30rpx 34rpx; /* 15px 17px */
  box-shadow: var(--shadow-ink-block);
  margin-top: 12rpx;
}
/* 脉冲红点：mn-pulse 呼吸 */
.dq__pulse {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-round);
  background: var(--color-vermilion);
  animation: mn-pulse 2.4s infinite;
}
.dq__tag {
  font-family: var(--font-mono);
  font-size: 20rpx; /* 10px */
  letter-spacing: 4rpx;
  color: var(--color-gold-text);
}
.dq__question {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 31rpx; /* 16px */
  color: var(--color-paper-start);
  margin-top: 18rpx;
  line-height: 1.5;
}
.dq__hint {
  font-size: 22rpx; /* 11.5px */
  color: var(--color-ink-on-dark);
  margin-top: 14rpx;
  line-height: 1.6;
}
.dq__cta {
  margin-top: 26rpx;
  text-align: center;
  background: var(--color-vermilion);
  border-radius: var(--radius-card);
  padding: 20rpx 0; /* 10px */
  font-size: 26rpx; /* 13px */
  color: var(--color-paper-start);
  font-weight: 500;
}
.dq__cta--hover {
  opacity: 0.9;
}

@keyframes mn-pulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.4;
    transform: scale(0.78);
  }
}
