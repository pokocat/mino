/* error-retry：居中错误占位，风格对齐列表空态。 */
.er {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--space-xl) 0;
  gap: var(--space-lg);
}
.er__title {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  color: var(--color-ink);
}
.er__hint {
  font-size: 24rpx;
  color: var(--color-ink-tertiary);
  text-align: center;
  line-height: var(--lh-ui);
}
.er__btn {
  margin-top: var(--space-sm);
  padding: 16rpx 48rpx;
  background: var(--color-vermilion);
  color: #fff;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  border-radius: var(--radius-chip);
  box-shadow: var(--shadow-seal);
}
.er__btn--hover {
  opacity: 0.85;
}
