/* 底部操作条：主按钮深墨金字 + 副按钮纸面朱砂图标。渐隐纸底压住正文。 */
.dab {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx var(--space-lg) 36rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(238, 230, 214, 0), var(--color-surface-tab) 40%);
}
.dab__primary {
  flex: 1;
  text-align: center;
  background: var(--color-ink);
  border-radius: var(--radius-card-lg);
  padding: 24rpx 0; /* 12px */
  font-size: 27rpx; /* 13.5px */
  font-weight: 500;
  color: var(--color-gold-text);
}
.dab__primary--hover {
  opacity: 0.9;
}
.dab__secondary {
  width: 90rpx; /* 46px */
  text-align: center;
  background: var(--color-card);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius-card-lg);
  padding: 24rpx 0;
  font-size: 32rpx; /* 16px */
  color: var(--color-vermilion);
}
.dab__secondary--hover {
  opacity: 0.85;
}
