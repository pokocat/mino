<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar__inner">
    <view class="nav-bar__side nav-bar__side--left" bindtap="onBack">
      <text wx:if="{{back}}" class="nav-bar__back">‹</text>
    </view>
    <text class="nav-bar__title">{{title}}</text>
    <view class="nav-bar__side nav-bar__side--right" bindtap="onAction">
      <text wx:if="{{actionText}}" class="nav-bar__action">{{actionText}}</text>
      <slot name="action"></slot>
    </view>
  </view>
</view>
