# ============ 米诺 V3 后端 · 生产环境变量样例 ============
# provision 脚本会以本文件为模板生成服务器上的 /opt/mino/server/.env，
# 并把 __占位__ 替换成实际值（端口 / 随机密钥 / 数据库密码）。
# 已存在的 .env 不会被覆盖——你后续手改的 LLM/微信凭据会被保留。

NODE_ENV=production
PORT=__PORT__

# ---- 数据库（复用系统 PostgreSQL，独立库/角色，UTF8）----
DATABASE_URL=postgresql://__PG_USER__:__PG_PASS__@__PG_HOST__:__PG_PORT__/__PG_DB__?schema=public

# ---- 缓存 / 队列（专属 redis 容器）----
REDIS_URL=redis://127.0.0.1:__REDIS_PORT__
QUEUE_ENABLED=true

# ---- 鉴权 ----
JWT_SECRET=__JWT_SECRET__
JWT_EXPIRES_IN=7d

# ---- 后台管理员 ----
# 运维后台单账号（登录换 12h JWT）。两项任一为空 → 后台登录被禁用（不可绕过）。
# 上线需要后台时：两项都填非空值，再 sudo systemctl restart mino-api。
ADMIN_USER=
ADMIN_PASS=

# ============================================================
# 下面是「产品方后续手动配置」的项。当前为可跑通联调的占位/mock 值。
# ============================================================

# ---- 微信小程序凭据（★上线前必填）----
# 未填且 WX_MOCK=true 时：登录不校验微信，openid = mock_<code hash>，可跑通联调，但非真实鉴权。
# 拿到 appid/secret 后：填入并把 WX_MOCK 改为 false，再 sudo systemctl restart mino-api。
WX_APPID=
WX_SECRET=
WX_MOCK=true
WX_TMPL_DAILY_Q=
WX_TMPL_REPORT_READY=
WX_PUSH_PAGE_CHAT=pages/chat/chat
WX_PUSH_PAGE_REPORTS=pages/reports/list

# ---- 内容安全（复用 WX_APPID/SECRET）----
SAFETY_FAIL_CLOSED=false

# ---- FastGPT / LLM 接入（★后续手配 API 端点与 AK）----
# 当前 FASTGPT_MOCK=true：后端不调外部 LLM，吐固定军师风格假流，用于端到端联调。
# 接入真实 LLM 时：填 FASTGPT_BASE_URL / FASTGPT_APP_KEY / FASTGPT_OPENAPI_KEY，
# 把 FASTGPT_MOCK 改为 false，再 restart。
# ---- LLM 供应商切换 ----
# provider=fastgpt（默认）走下方 FastGPT；provider=openai 直连 OpenAI 兼容端点（推荐用于当前联调）。
# 直连时填以下三项并把 FASTGPT_MOCK 设为 false：
#   LLM_BASE_URL 形如 https://openai.sufy.com/v1  （末尾到 /v1；服务会自动补 /chat/completions）
#   LLM_MODEL    OpenAI 兼容的模型名
LLM_PROVIDER=fastgpt
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 每用户记忆 embedding（Phase 1 · pgvector 持久化记忆）----
# 仅当 LLM_PROVIDER=openai 时启用；此时若 EMBEDDING_API_KEY 非空 → 记忆写入/检索走 pgvector
# （前置：provision 已装好 pgvector 扩展）；留空 → 降级进程内存 Map（重启丢记忆，启动告警一次）。
# 默认 SiliconFlow bge-large-zh-v1.5（1024 维）；向量库连接串复用上面的 DATABASE_URL。
# 注意：EMBEDDING_DIM 必须与 EMBEDDING_MODEL 实际维度一致；共享向量表首次写入时按此维度建，
#       之后改维度需先删表（DROP TABLE mino_memory）再重启。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024

FASTGPT_BASE_URL=
FASTGPT_APP_KEY=
FASTGPT_OPENAPI_KEY=
FASTGPT_MOCK=true
FASTGPT_KB_VECTOR_MODEL=text-embedding-3-small
FASTGPT_KB_AGENT_MODEL=gpt-4o-mini
