# 米诺（mino）后端部署 —— 单一配置来源
# 迁移 / 换域名 / 换端口时，只改这里（或用同名环境变量覆盖），脚本与 skill 全部引用本文件。
# 用法：脚本内部 `source deploy/mino/config.env`；也可 `KEY=值 ./deploy/mino/02-deploy.sh` 临时覆盖。

# ---- 本机 → 服务器的 SSH/rsync 接入 ----
SSH_KEY="${SSH_KEY:-$HOME/dev/aliyun/aiartist.pem}"
SSH_HOST="${SSH_HOST:-ecs-user@8.136.36.175}"

# ---- 对外接入端点（小程序请求的 https://$DOMAIN/$API_PREFIX）----
# 说明：当前为「临时复用」junshi 所在服务器；迁移时改 DOMAIN / API_PREFIX 即可。
DOMAIN="${DOMAIN:-wxapi.aibuzz.cn}"
API_PREFIX="${API_PREFIX:-api_mino}"

# ---- 服务器侧运行参数（均与既有 junshi 服务隔离，互不影响）----
UPSTREAM_PORT="${UPSTREAM_PORT:-4100}"        # NestJS 监听端口（仅 127.0.0.1；junshi 占 4000）
REDIS_PORT="${REDIS_PORT:-6380}"              # 专属 redis 容器宿主端口（127.0.0.1）
PG_HOST="${PG_HOST:-127.0.0.1}"
PG_PORT="${PG_PORT:-5432}"                     # 复用系统 PostgreSQL；mino 用独立库/角色
PG_DB="${PG_DB:-mino}"
PG_USER="${PG_USER:-mino}"
DEPLOY_DIR="${DEPLOY_DIR:-/opt/mino/server}"   # 后端代码落地目录
SERVICE_USER="${SERVICE_USER:-mino}"           # 运行服务的系统用户（隔离权限）
SERVICE_NAME="${SERVICE_NAME:-mino-api}"       # systemd 服务名
REDIS_CONTAINER="${REDIS_CONTAINER:-mino-redis}"

# ---- nginx（既有共享配置文件；本部署仅「新增」一个 location，不改动 junshi 现有块）----
NGINX_CONF="${NGINX_CONF:-/etc/nginx/conf.d/junshi.conf}"

# 服务器上存放机密的目录（.env / 数据库密码 / JWT 密钥；权限 600，永不进仓库）
SECRET_DIR="${SECRET_DIR:-/opt/mino}"
