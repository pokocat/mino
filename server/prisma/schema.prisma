// 米诺 V3 数据模型 —— 依据《V3-设计与规划方案》§5（修订版）
// 说明：字段名 / 枚举取值严格按方案；命理相关表（bazi_profiles / monthly_fortunes /
// 评分表 / milestones / rank_events）一律不建。派生统计（报告计数等）走接口聚合，不落表。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 枚举 ============

enum MessageRole {
  user
  assistant
}

enum ReportType {
  strategy // 战略分析
  resume // 创业履历
  review // 复盘战报
  decision // 决策记录
}

enum ReportStatus {
  generating // 异步生成中
  ready // 已就绪
  failed // 生成失败
}

enum ReportOrigin {
  user // 用户点生成
  agent // 军师主动写
}

enum TaskType {
  daily_q // 今日一问
  random // 随机邀约（本期仅占位，二期启用）
}

enum TaskStatus {
  pending
  started
  done
  expired
}

// ============ 模型 ============

model User {
  id        String  @id @default(uuid())
  wxOpenid  String  @unique @map("wx_openid")
  wxUnionid String? @map("wx_unionid")
  nickname  String?
  avatarUrl String? @map("avatar_url")

  industry String? // 行业
  bizNote  String? @map("biz_note") // 一句话生意背景

  streakDays     Int       @default(0) @map("streak_days")
  lastActiveDate DateTime? @map("last_active_date") @db.Date // Asia/Shanghai 日界

  kbId String? @map("kb_id") // FastGPT 每用户知识库 id

  createdAt DateTime @default(now()) @map("created_at")

  conversations Conversation[]
  reports       Report[]
  tasks         Task[]

  @@map("users")
}

model Conversation {
  id            String @id @default(uuid())
  userId        String @map("user_id")
  fastgptChatId String @map("fastgpt_chat_id") // 对应 FastGPT 的 chatId

  title         String? // 首轮后由 LLM 生成的一句话标题（供溯源展示）
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  // 「跟军师聊这份报告」新建会话时记录源报告 id：首轮对话额外把该报告全文拼入上下文
  // （附加 system 机制，与 M3 知识库检索注入同源；不落 messages 表、不下发端上）
  seedReportId String? @map("seed_report_id")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  tasks    Task[]

  // 报告 <-> 对话 多对多（支撑「3 段织成」）
  reportSources ReportSource[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String      @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Report {
  id     String       @id @default(uuid())
  userId String       @map("user_id")
  type   ReportType
  status ReportStatus @default(generating) // 异步生成态

  title      String
  bodyMd     String  @map("body_md") @db.Text // 正文（唯一事实源）
  annotation String? @db.Text // 军师批注（独立字段，不混入 body_md）

  origin    ReportOrigin
  wordCount Int          @default(0) @map("word_count")

  isRead Boolean   @default(false) @map("is_read") // 「军师刚写好」未读态
  readAt DateTime? @map("read_at")

  sequenceNo Int? @map("sequence_no") // 创业履历「第一篇」编号（type=resume）

  // 类型专属元数据：decision.verify_status('pending'|'verified'|'failed')、
  // kb_synced(bool 存入知识库标记) 等
  meta Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources ReportSource[]

  @@index([userId, type])
  @@map("reports")
}

// 报告 <-> 对话 多对多关联（一份报告可由多段对话织成）
model ReportSource {
  reportId       String @map("report_id")
  conversationId String @map("conversation_id")

  report       Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([reportId, conversationId])
  @@map("report_sources")
}

model Task {
  id     String     @id @default(uuid())
  userId String     @map("user_id")
  type   TaskType
  status TaskStatus @default(pending)

  question   String  @db.Text
  hint       String? @db.Text // 钩子文案（卡片副标题；今日一问由 LLM 一并产出）
  promptSeed String  @map("prompt_seed") @db.Text // 进对话时的开场
  estMinutes Int?    @map("est_minutes") // 「约 3 分钟」

  conversationId String? @map("conversation_id")

  pushedAt  DateTime? @map("pushed_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("tasks")
}
