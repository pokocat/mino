# ============ 米诺 V3 后端环境变量（占位样例）============
# 复制为 .env 后填入真实值。切勿把 .env 提交到仓库。

# 运行环境：development | production | test
NODE_ENV=development
# 服务监听端口
PORT=3000

# ---- 数据库（PostgreSQL 16）----
DATABASE_URL=postgresql://mino:mino@localhost:5432/mino?schema=public

# ---- 缓存 / 队列（Redis 7 + BullMQ）----
REDIS_URL=redis://localhost:6379
# 队列开关：置 false 显式关闭 kb.ingest（记忆写入）队列。
# 记忆是旁路：Redis 不可达或本项为 false 时，应用照常启动、对话不受影响，
# 仅「对话要点写入知识库」这一后台任务降级为空操作（入队失败仅告警日志）。
QUEUE_ENABLED=true

# ---- 鉴权（JWT）----
# 生产务必替换为足够长度的随机密钥
JWT_SECRET=please-change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- 微信小程序 ----
WX_APPID=your-wx-appid
WX_SECRET=your-wx-secret
# Mock 登录 / 推送：true 时不请求微信——登录 openid = mock_<code 的 hash>；
# 订阅消息（今日一问 / 报告完成）不触外网，仅结构化打印 [mock push]。
# 本地/联调无真实 appid/secret 时置 true，可跑通登录与回访闭环。
WX_MOCK=false
# ---- 微信订阅消息模板（M5 回访；产品方在微信后台申请后填入真实模板 id）----
# 今日一问推送模板 id
WX_TMPL_DAILY_Q=
# 报告写好了推送模板 id
WX_TMPL_REPORT_READY=
# 订阅消息点击后跳转的小程序页面
WX_PUSH_PAGE_CHAT=pages/chat/chat
WX_PUSH_PAGE_REPORTS=pages/reports/list

# ---- 内容安全（M6 · R7；msgSecCheck 复用上面的 WX_APPID/WX_SECRET 与 WX_MOCK）----
# 审核失败策略：默认 false=fail-open（微信接口挂时放行 + 告警，不阻断主链路）；
# true=fail-closed 严格模式（审核不可用时一律拦截）。生产按合规要求权衡。
SAFETY_FAIL_CLOSED=false

# ---- FastGPT（自托管）----
# 米诺应用 / 报告工作流 / 知识库 OpenAPI 的接入点与密钥
FASTGPT_BASE_URL=http://localhost:3001
# 米诺应用对话 API Key（sk-...）
FASTGPT_APP_KEY=fastgpt-app-key
# 知识库 / 账号级 OpenAPI Key（用于建每用户知识库）
FASTGPT_OPENAPI_KEY=fastgpt-openapi-key
# Mock 米诺：true 时后端不调外部 FastGPT，按固定米诺风格吐假流（含跨 chunk 拆分的 report_ready 标记）。
# 本地/联调无 FastGPT 时置 true，可把「登录→建会话→SSE 流式对话」闭环跑通。
# FASTGPT_MOCK=true 时，每用户知识库（建库/写入/检索）也走进程内存实现（kbId=mock_kb_<userId>），
# 因此「对话要点写入知识库 → 下轮检索拼进上下文」的记忆闭环无真实 FastGPT 也可跑通与测试。
FASTGPT_MOCK=false
# 每用户知识库建库所需模型名（须与产品方 FastGPT config.json 中登记的模型名一致；仅真实模式用到）
FASTGPT_KB_VECTOR_MODEL=text-embedding-3-small
FASTGPT_KB_AGENT_MODEL=gpt-4o-mini

# ---- LLM 供应商切换 ----
# fastgpt（默认，走自托管 FastGPT 应用）| openai（直连 OpenAI 兼容端点，LLM_BASE_URL 形如 https://host/v1）
LLM_PROVIDER=fastgpt
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 每用户记忆 embedding（Phase 1 · pgvector 持久化记忆）----
# 仅当 LLM_PROVIDER=openai 时启用：EMBEDDING_API_KEY 非空 → 记忆走 pgvector（@mastra/pg，
# 连接串复用上面的 DATABASE_URL，需库启用 vector 扩展——本地 pgvector/pgvector:pg16 镜像 + 迁移已建）；
# 留空 → openai 模式下记忆降级进程内存 Map（重启丢失，启动告警一次）。
# 默认 SiliconFlow bge-large-zh-v1.5（1024 维）。EMBEDDING_DIM 必须与模型维度一致。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024
